           IF VIAL0001-DEBUG-SIM
              MOVE '2600-TRATA-EXTRATO '   TO VIAL0015-CALLER-ID
              MOVE 'SQLCODE'               TO VIAL0015-CAMPO-NM(1)
              MOVE SQLCODE                 TO VIAL0015-CAMPO-VLR(1)
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
       2600-TRATA-EXTRATO-EXIT.
           EXIT.
      *
      *--------------------------------------------------------------
      *                   2610-REGISTA-EXTRATO
      *--------------------------------------------------------------
       2610-REGISTA-EXTRATO.
      *
           IF VIAL0001-DEBUG-SIM
              MOVE '2610-REGISTA-EXTRATO'  TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
           MOVE WS-DATA-EXTRATO            TO SWCD7401-DDATAUPL.
           MOVE SWCV9940-CFILEXTR          TO SWCD7401-CFILEXTR.
           MOVE SWCV9940-CLIBRNAM          TO SWCD7401-CLIBRNAM.
           MOVE SWCV9940-CFILENAM          TO SWCD7401-CFILENAM.
           IF SW-EXTRATO-OK
              MOVE CON-PROCESSADO          TO SWCD7401-CPROCESS
           ELSE
              MOVE CON-COM-ERROS           TO SWCD7401-CPROCESS
           END-IF
           MOVE WS-GDESCERR                TO SWCD7401-GDESCERR
           MOVE VIAL0001-CUTILIZA-I        TO SWCD7401-CUSERIDC.
           MOVE WS-PROGNAME                TO SWCD7401-CUSERID.

           PERFORM 2620-OBTER-SEQ
              THRU 2620-OBTER-SEQ-EXIT.
      *
           IF VIAL0002-SEM-ERROS

              EXEC SQL
                 INSERT
                   INTO SWVT7401 (
                        DDATAUPL
                      , ZSEQFILE
                      , CFILEXTR
                      , CLIBRNAM
                      , CFILENAM
                      , CPROCESS
                      , GDESCERR
                      , CUSERIDC
                      , HTIMESTC
                      , CUSERID
                      , HTIMEST
                   )
                 VALUES (
                        :SWCD7401-DDATAUPL
                      , :SWCD7401-ZSEQFILE
                      , :SWCD7401-CFILEXTR
                      , :SWCD7401-CLIBRNAM
                      , :SWCD7401-CFILENAM
                      , :SWCD7401-CPROCESS
                      , :SWCD7401-GDESCERR
                      , :SWCD7401-CUSERIDC
                      , CURRENT TIMESTAMP
                      , :SWCD7401-CUSERID
                      , CURRENT TIMESTAMP
                   )
              END-EXEC
      *
              MOVE CON-SWVT7401               TO VIAL0002-TABLE-NAME
      *
              PERFORM 9020-DB2CHECK
                 THRU 9029-DB2CHECK-EXIT
      *
              EVALUATE TRUE
                 WHEN DB2-OK
                    CONTINUE
                 WHEN OTHER
                    MOVE VIAK0002-ERROS-FUNCAO
                                              TO VIAL0002-IND-ERROS
                    MOVE SWCK0002-STATUS-ACTIVO
                                              TO SWCV9941-CFILEXTR-S
                    MOVE SWCK0001-ERR-INS-SWT74
                                              TO SWCV9941-CFILEXTR-MSG
                    MOVE SWCK0002-CAPLIC     TO SWCV9941-CFILEXTR-CAPLIC
              END-EVALUATE
      *
              IF VIAL0001-DEBUG-SIM
                 MOVE '2610-REGISTA-EXTRATO ' TO VIAL0015-CALLER-ID
                 MOVE 'SQLCODE'               TO VIAL0015-CAMPO-NM(1)
                 MOVE SQLCODE                 TO VIAL0015-CAMPO-VLR(1)
                 PERFORM VIAP0016-TRATA-DEBUG
                    THRU VIAP0016-TRATA-DEBUG-EXIT
              END-IF
           END-IF.
      *
       2610-REGISTA-EXTRATO-EXIT.
           EXIT.
      *
      *--------------------------------------------------------------
      *                   2620-OBTER-SEQ
      *--------------------------------------------------------------
       2620-OBTER-SEQ.
      *
           IF VIAL0001-DEBUG-SIM
              MOVE '2620-OBTER-SEQ'        TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
           EXEC SQL
              SELECT IFNULL( MAX( ZSEQFILE ), 0 ) + 1
                INTO :SWCD7401-ZSEQFILE
                FROM SWVT7401
               WHERE DDATAUPL  =  :SWCD7401-DDATAUPL
           END-EXEC.
      *
           MOVE CON-SWVT7401               TO VIAL0002-TABLE-NAME.
      *
           PERFORM 9020-DB2CHECK
              THRU 9029-DB2CHECK-EXIT.
      *
           EVALUATE TRUE
              WHEN DB2-OK
                 CONTINUE
              WHEN OTHER
                 MOVE VIAK0002-ERROS-FUNCAO
                                           TO VIAL0002-IND-ERROS
                 MOVE SWCK0002-STATUS-ACTIVO
                                           TO SWCV9941-CFILEXTR-S
                 MOVE SWCK0001-ERR-ZSQFILE TO SWCV9941-CFILEXTR-MSG
                 MOVE SWCK0002-CAPLIC      TO SWCV9941-CFILEXTR-CAPLIC
           END-EVALUATE.

           IF VIAL0001-DEBUG-SIM
              MOVE '2620-OBTER-SEQ     '   TO VIAL0015-CALLER-ID
              MOVE 'SQLCODE'               TO VIAL0015-CAMPO-NM(1)
              MOVE SQLCODE                 TO VIAL0015-CAMPO-VLR(1)
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           IF VIAL0001-DEBUG-SIM
              MOVE '2620-OBTER-SEQ     '   TO VIAL0015-CALLER-ID
              MOVE 'SWCD7401-ZSEQFILE'     TO VIAL0015-CAMPO-NM(1)
              MOVE SWCD7401-ZSEQFILE       TO VIAL0015-CAMPO-VLR(1)
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
       2620-OBTER-SEQ-EXIT.
           EXIT.
      *
      *--------------------------------------------------------------
      *            3000-FINAL-PROGRAMA
      *--------------------------------------------------------------
       3000-FINAL-PROGRAMA.
      *
           IF VIAL0001-DEBUG-SIM
              MOVE '3000-FINAL-PROGRAMA'   TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
           MOVE SWCV9941-MSG               TO VIAL0001-MENSAGEM-OUTPUT.
           MOVE SWCV9941-LENGTH            TO VIAL0001-LENGTH-MSG.
           MOVE SWCV9941-NR-CAMPOS         TO VIAL0001-NR-CAMPOS.
           MOVE ZEROES                     TO VIAL0001-OCORRENCIAS.
      *
       3099-FINAL-PROGRAMA-EXIT.
           EXIT.
      *
      *--------------------------------------------------------------
           EXEC SQL INCLUDE VIAP0003 END-EXEC.
      *==============================================================
           COPY VIAP0016.
           COPY VIAP0011.
           COPY AQCP0005.
