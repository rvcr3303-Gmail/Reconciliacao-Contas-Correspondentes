           EXEC SQL DECLARE SWVT6103 TABLE
           (
               FYCODMSG CHAR(6) NOT NULL
             , FYDATVAL DECIMAL(8,0) NOT NULL
             , FYIDTAB DECIMAL(6,0) NOT NULL
             , FYREF CHAR(16) NOT NULL
             , FYREF950 CHAR(16) NOT NULL
             , FYCSEND CHAR(15) NOT NULL
