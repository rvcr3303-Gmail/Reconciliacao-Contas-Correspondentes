           IF VIAL0001-DEBUG-SIM
              MOVE '2500-TRATA-SALDO'     TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
           MOVE CON-CBAN                   TO SWCD7302-CBAN
           MOVE CON-CSPAI                  TO SWCD7302-CSPAI
           MOVE CON-S                      TO SWCD7302-ISALDEXT
           MOVE WS-CMOEDA                  TO SWCD7302-CMOED
           MOVE WS-DATA-EXTRATO            TO SWCD7302-DATVAL
           MOVE WS-MSALDO                  TO SWCD7302-MSALDEXT
           MOVE WS-PROGNAME                TO SWCD7302-CUSERID.
      *
           EXEC SQL
              UPDATE SWVT7302
                 SET MSALDEXT   =  :SWCD7302-MSALDEXT
                   , CUSERID    =  :SWCD7302-CUSERID
                   , HTIMEST    =  CURRENT TIMESTAMP
               WHERE CBAN       =  :SWCD7302-CBAN
                 AND CSPAI      =  :SWCD7302-CSPAI
                 AND CMOED      =  :SWCD7302-CMOED
                 AND DATVAL     =  :SWCD7302-DATVAL
                 AND ISALDEXT   =  :SWCD7302-ISALDEXT
           END-EXEC.
      *
           MOVE CON-SWVT7302               TO VIAL0002-TABLE-NAME
      *
           PERFORM 9020-DB2CHECK
              THRU 9029-DB2CHECK-EXIT
      *
           EVALUATE TRUE
              WHEN DB2-OK
                 CONTINUE
              WHEN DB2-NOTFND
                 PERFORM 2510-REGISTA-SALDO
                    THRU 2510-REGISTA-SALDO-EXIT
              WHEN OTHER
                 MOVE VIAK0002-ERROS-FUNCAO
                                           TO VIAL0002-IND-ERROS
                 MOVE SWCK0002-STATUS-ACTIVO
                                           TO SWCV9941-CFILEXTR-S
                 MOVE SWCK0001-ERR-UPD-SWT73
                                           TO SWCV9941-CFILEXTR-MSG
                 MOVE SWCK0002-CAPLIC      TO SWCV9941-CFILEXTR-CAPLIC
                 MOVE 'Erro no Update da SWT73'
                                           TO WS-GDESCERR
           END-EVALUATE.
      *
           IF VIAL0001-DEBUG-SIM
              MOVE '2500-TRATA-SALDO   '   TO VIAL0015-CALLER-ID
              MOVE 'SQLCODE'               TO VIAL0015-CAMPO-NM(1)
              MOVE SQLCODE                 TO VIAL0015-CAMPO-VLR(1)
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
       2500-TRATA-SALDO-EXIT.
           EXIT.
      *
      *--------------------------------------------------------------
      *                   2510-REGISTA-SALDO
      *--------------------------------------------------------------
       2510-REGISTA-SALDO.
      *
           IF VIAL0001-DEBUG-SIM
              MOVE '2510-REGISTA-SALDO'     TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.
      *
           PERFORM 2520-OBTEM-CCB
              THRU 2520-OBTEM-CCB-EXIT.
      *
           IF VIAL0002-SEM-ERROS
              MOVE CON-CBAN                TO SWCD7302-CBAN
              MOVE CON-CSPAI               TO SWCD7302-CSPAI
              MOVE NCCCBCOR-NCCCBALC       TO SWCD7302-NBALC
              MOVE NCCCBCOR-NCCCCCB        TO SWCD7302-CCB
              MOVE WS-CMOEDA               TO SWCD7302-CMOED
      *
              MOVE WS-DATA-EXTRATO         TO SWCD7302-DATVAL
              MOVE ZEROS                   TO SWCD7302-MSALDMOV
              MOVE WS-MSALDO               TO SWCD7302-MSALDEXT
              MOVE CON-S                   TO SWCD7302-ISALDEXT
              MOVE CON-N                   TO SWCD7302-ISALDMOV

              EXEC SQL
                 INSERT
                   INTO SWVT7302 (
                        CBAN
                      , CSPAI
                      , NBALC
                      , CCB
                      , CMOED
                      , DATVAL
                      , MSALDMOV
                      , MSALDEXT
                      , CUSERID
                      , HTIMEST
                      , ISALDEXT
                      , ISALDMOV
                   )
                 VALUES (
                        :SWCD7302-CBAN
                      , :SWCD7302-CSPAI
                      , :SWCD7302-NBALC
                      , :SWCD7302-CCB
                      , :SWCD7302-CMOED
                      , :SWCD7302-DATVAL
                      , :SWCD7302-MSALDMOV
                      , :SWCD7302-MSALDEXT
                      , :SWCD7302-CUSERID
                      , CURRENT TIMESTAMP
                      , :SWCD7302-ISALDEXT
                      , :SWCD7302-ISALDMOV
                   )
              END-EXEC
      *
              MOVE CON-SWVT7302            TO VIAL0002-TABLE-NAME
      *
              PERFORM 9020-DB2CHECK
                 THRU 9029-DB2CHECK-EXIT
      *
              EVALUATE TRUE
                 WHEN DB2-OK
                    CONTINUE
                 WHEN DB2-DUPREC
                    PERFORM 2511-ALTERA-SALDO
                       THRU 2511-ALTERA-SALDO-EXIT
                 WHEN OTHER
                    MOVE VIAK0002-ERROS-FUNCAO
                                              TO VIAL0002-IND-ERROS
                    MOVE SWCK0002-STATUS-ACTIVO
                                              TO SWCV9941-CFILEXTR-S
                    MOVE SWCK0001-ERR-INS-SWT73
                                              TO SWCV9941-CFILEXTR-MSG
                    MOVE SWCK0002-CAPLIC     TO SWCV9941-CFILEXTR-CAPLIC
                    MOVE 'Erro no Insert da SWT73'
                                              TO WS-GDESCERR
              END-EVALUATE
           END-IF.
