/***********************************************************************/
      PGM PARM(&RCODE)
/***********************************************************************/
      DCL VAR(&RCODE)   TYPE(*DEC)  LEN(1 0)
/***********************************************************************/
      CALL     PGM(SWB4045) PARM(&RCODE)

/***********************************************************************/
  CPYPDF:
      CPYSPLF  FILE(SWREPORT) TOFILE(*TOSTMF) SPLNBR(*LAST)            +
               TOSTMF('/BCIMAPP/VIA_APP/tmp/REPORTSW.PDF') WSCST(*PDF) +
               STMFOPT(*REPLACE)

/***                                                                 ***/
  FINISH:
      ENDPGM
