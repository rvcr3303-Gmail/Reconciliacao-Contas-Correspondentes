             , FYREFREL CHAR(16) NOT NULL
             , CUSRINT CHAR(10) NOT NULL
             , HTIMINT CHAR(26) NOT NULL
             , COSN CHAR(10) NOT NULL
             , COSNC CHAR(10) NOT NULL
             , CEXT CHAR(05) NOT NULL
             , CPAG  CHAR(05) NOT NULL
           ) END-EXEC.
      ******************************************************************
      * COBOL DECLARATION FOR TABLE SWVT6103
      ******************************************************************
       01  DCLSWCD6103.
            05 SWCD6103-FYCODMSG PIC X(06).
            05 SWCD6103-FYDATVAL PIC S9(08) COMP-3.
            05 SWCD6103-FYIDTAB PIC S9(06) COMP-3.
            05 SWCD6103-FYREF PIC X(16).
