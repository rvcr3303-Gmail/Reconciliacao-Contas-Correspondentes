           EXEC SQL DECLARE SWVT6003 TABLE
           (
               FXCODMSG CHAR(6) NOT NULL
             , FXDATVAL DECIMAL(8,0) NOT NULL
             , FXREFOPR CHAR(16) NOT NULL
             , FXREF CHAR(16) NOT NULL
             , FXREF940 CHAR(16) NOT NULL
             , FXCSEND CHAR(15) NOT NULL
             , FXCODEST CHAR(2) NOT NULL
             , FXTIPOP CHAR(10) NOT NULL
             , FXVALOR DECIMAL(15,2) NOT NULL
