       IDENTIFICATION DIVISION.
       PROGRAM-ID.    SWI51500.
      ******************************************************************
      *     PROGRAMA SWI51500.                                         *
      *                                                                *
      *     Movimentos Correspondentes
      ******************************************************************
      *     LOG ALTERACOES:                                            *
      *   USER     / DATA     /   REFERENCIA / OBSERVACOES             *
      *                                                                *
      *                                                                *
      ******************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       DATA DIVISION.
      *-----------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *-----------------------------------------------------------------
       01  FILLER                          PIC X(40) VALUE
           'INICIO WORKING-STORAGE SWI51500         '.
      *-----------------------------------------------------------------
      *            DECLARACOES DE DB2
      *-----------------------------------------------------------------
           EXEC SQL INCLUDE SWCD5808 END-EXEC.
           EXEC SQL INCLUDE SQLCA    END-EXEC.

      *-----------------------------------------------------------------
      *            MENSAGEM DE INPUT E  OUTPUT
      *-----------------------------------------------------------------
       COPY SWCV5150.
       COPY SWCV5151.

      *-----------------------------------------------------------------
      *            AREAS DE TRABALHO
      *-----------------------------------------------------------------
       COPY VIAL0015.
       COPY VIAW0005.
       COPY VIAK0001.
       COPY VIAK0002.
       COPY SWCK0001.
       COPY SWCK0002.
       COPY AQCW0005.
       COPY ETCL0002.
       COPY ARCL0039.

      *-----------------------------------------------------------------
      *            AREAS DE TRABALHO
      *-----------------------------------------------------------------
      *-----------------------------------------------------------------
      *            SWITCH
      *-----------------------------------------------------------------
       01  SW-SWITCH.
           05 SW-CURSOR                    PIC X(01) VALUE SPACES.
              88 SW-CURSOR-NONE                      VALUE '0'.
              88 SW-CURSOR-1                         VALUE '1'.

      *-----------------------------------------------------------------
      *            VARIAVEIS
      *-----------------------------------------------------------------
        01  WS-VARIAVEIS.
            05 WS-CSEND                    PIC  X(12) VALUE SPACES.
            05 FILLER REDEFINES WS-CSEND.
               10 WS-C2COD-CBAN            PIC  X(04).
               10 WS-C2COD-CSPAI           PIC  X(02).
               10 FILLER                   PIC  X(06).
            05 WS-CCONTA                   PIC  X(20) VALUE SPACES.
            05 FILLER REDEFINES WS-CCONTA.
               10 WS-CCOD-NCCCBALC         PIC  9(04).
               10 FILLER                   PIC  X(01).
               10 WS-CCOD-NCCCCCB          PIC  X(13).
               10 FILLER                   PIC  X(02).

            05 WS-CSBALC                   PIC S9(04) COMP-3 VALUE 0.
            05 WS-CSMOED                   PIC  X(03) VALUE SPACES.
            05 WS-MONTANTE                 PIC  9(15)V99.
            05 WS-DATAVL-MAX               PIC S9(08) COMP-3 VALUE 0.

      *-----------------------------------------------------------------
      *            CONSTANTES
      *-----------------------------------------------------------------
       01  WS-CONSTANTES.
           05 WS-PROGNAME                  PIC X(08) VALUE 'SWI51500'.
           05 CON-SWVT5808                 PIC X(08) VALUE 'SWVT5808'.
           05 CON-CCODEST-RECONCILIADO     PIC X(02) VALUE 'RC'.
           05 CON-DATA-MAX                 PIC X(10) VALUE '9999-12-31'.

      *-----------------------------------------------------------------
      *              DECLARACOES DE CURSORES DB2
      *-----------------------------------------------------------------
       01  WS-CURSOR-VARS.
           05 FILLER                       PIC X(01) VALUE SPACES.
           EXEC SQL
                DECLARE CURSWT58 CURSOR FOR
                 SELECT DATVAL
                      , COSN
                      , COSNC
                      , CREF
                      , CREFOPR
                      , CREFEXT
                      , CTIPOP
                      , MVALOR
                      , CDBCR
                      , CEXT
                      , CPAG
                 FROM SWVT5808
                 WHERE CBAN    =  :SWCD5808-CBAN
                   AND CSPAI   =  :SWCD5808-CSPAI
                   AND CMOED   =  :SWCD5808-CMOED
                   AND CCODEST <> :CON-CCODEST-RECONCILIADO
                   AND DATVAL  <= :WS-DATAVL-MAX
      * Paginacao
                   AND (
                       DATVAL  =  :SWCD5808-DATVAL
                   AND COSN    =  :SWCD5808-COSN
                   AND COSNC   >  :SWCD5808-COSNC

                    OR DATVAL  =  :SWCD5808-DATVAL
                   AND COSN    >  :SWCD5808-COSN

                    OR DATVAL  >  :SWCD5808-DATVAL )

                 ORDER BY DATVAL
                        , COSN
                        , COSNC
           END-EXEC.

      *-----------------------------------------------------------------
       01  FILLER                        PIC X(40) VALUE
           'FIM DA WORKING-STORAGE SWI51500         '.

      *-----------------------------------------------------------------
       LINKAGE SECTION.
      *-----------------------------------------------------------------
       COPY VIAL0004.

            EXEC SQL INCLUDE VIAP0009 END-EXEC.

      *-----------------------------------------------------------------
      *            0000-MAINLINE
      *-----------------------------------------------------------------
       0000-MAINLINE.
           PERFORM 1000-INICIO-PROGRAMA
              THRU 1099-INICIO-PROGRAMA-EXIT.

           PERFORM 2000-PROC-PROGRAMA
              THRU 2099-PROC-PROGRAMA-EXIT.

           PERFORM 3000-FINAL-PROGRAMA
              THRU 3099-FINAL-PROGRAMA-EXIT.

       0099-MAINLINE-EXIT.
           COPY VIAP0004.

      *-----------------------------------------------------------------
      *            1000-INICIO-PROGRAMA
      *-----------------------------------------------------------------
       1000-INICIO-PROGRAMA.
           IF VIAL0001-DEBUG-SIM
              MOVE '1000-INICIO-PROGRAMA'  TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           MOVE VIAL0001-MENSAGEM-INPUT    TO SWCV5150-MSG.
           MOVE SWCV5150-ASE               TO SWCV5151-ASE.

           MOVE ZEROES                     TO SWCV5151-INDICE.
           PERFORM 1100-LIMPA-OCCURS
              THRU 1199-LIMPA-OCCURS-EXIT
                UNTIL SWCV5151-PAGINA-CHEIA.

       1099-INICIO-PROGRAMA-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *            1100-LIMPA-OCCURS
      *-----------------------------------------------------------------
       1100-LIMPA-OCCURS.
           ADD 1                           TO SWCV5151-INDICE.

           MOVE VIAK0002-DATA-MINIMA
                            TO SWCV5151-D-DATVAL(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-COSN(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-COSNC(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CREF(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CREFOPR(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CREFEXT(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CTIPOP(SWCV5151-INDICE).
           MOVE ZEROES      TO SWCV5151-D-MVALOR(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CDBCR(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CEXT(SWCV5151-INDICE).
           MOVE SPACES      TO SWCV5151-D-CPAG(SWCV5151-INDICE).

       1199-LIMPA-OCCURS-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *            2000-PROC-PROGRAMA
      *-----------------------------------------------------------------
       2000-PROC-PROGRAMA.
           IF VIAL0001-DEBUG-SIM
              MOVE '2000-PROC-PROGRAMA'    TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           MOVE SWCV5150-NOMEFXLS          TO SWCV5151-NOMEFXLS.
           MOVE SWCV5150-NMAXLIST          TO SWCV5151-NMAXLIST.
           MOVE SWCV5150-DATVAL-PAG        TO SWCV5151-DATVAL-PAG.
           MOVE SWCV5150-COSN-PAG          TO SWCV5151-COSN-PAG.
           MOVE SWCV5150-COSNC-PAG         TO SWCV5151-COSNC-PAG.
           MOVE SWCV5150-CPERFIL           TO SWCV5151-CPERFIL.
           MOVE SWCV5150-CSEND             TO SWCV5151-CSEND.
           MOVE SWCV5150-CCONTA            TO SWCV5151-CCONTA.
           MOVE SWCV5150-CMOED             TO SWCV5151-CMOED.
PML24 *    MOVE SWCV5150-IRECONC           TO SWCV5151-IRECONC.
PML24      MOVE SWCV5150-CCODEST           TO SWCV5151-CCODEST.
           MOVE SWCV5150-CINTERV           TO SWCV5151-CINTERV.
           MOVE SWCV5150-GUSERNAME         TO SWCV5151-GUSERNAME.
PML24 *    MOVE SWCV5150-DDATAF            TO SWCV5151-DDATAF.
PML24      MOVE SWCV5150-DDATA             TO SWCV5151-DDATA.

           PERFORM 2010-VALIDACOES
              THRU 2019-VALIDACOES-EXIT.

           IF VIAL0002-SEM-ERROS
              PERFORM 2020-OPEN
                 THRU 2029-OPEN-EXIT
           END-IF.

           IF VIAL0002-SEM-ERROS
              PERFORM 2030-FETCH
                 THRU 2039-FETCH-EXIT

              IF VIAL0002-SEM-ERROS
                 IF DB2-OK
                    PERFORM 2040-CONTINUA
                       THRU 2049-CONTINUA-EXIT
                 ELSE
                   COMPUTE SWCV5151-DIMINUI-LENGTH EQUAL
                     SWCV5151-INDICE-INVERSO * SWCV5151-LENGTH-OCCUR
                   COMPUTE SWCV5151-LENGTH EQUAL SWCV5151-LENGTH
                         - SWCV5151-DIMINUI-LENGTH
                   MOVE VIAK0002-ERROS-FUNCAO  TO VIAL0002-IND-ERROS
                   MOVE SWCK0002-STATUS-ACTIVO TO SWCV5151-CSEND-S
                   MOVE SWCK0001-ERR-CSEND     TO SWCV5151-CSEND-MSG
                 END-IF
              END-IF

              PERFORM 2070-CLOSE
                 THRU 2079-CLOSE-EXIT
           END-IF.

       2099-PROC-PROGRAMA-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *                   2010-VALIDACOES
      *-----------------------------------------------------------------
       2010-VALIDACOES.
           IF VIAL0001-DEBUG-SIM
              MOVE '2010-VALIDACOES' TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           CONTINUE.

       2019-VALIDACOES-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *                     2020-OPEN
      *-----------------------------------------------------------------
       2020-OPEN.
           IF VIAL0001-DEBUG-SIM
              MOVE '2020-OPEN'             TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

      *    MOVE SWCV5150-DDATAF            TO SWCV5150-DATVAL-PAG.
      *    IF SWCV5150-DATVAL-PAG NOT EQUAL VIAK0002-DATA-MINIMA
      *       MOVE SWCV5150-DATVAL-PAG     TO AQCW0005-DTX10
      *       PERFORM AQCP0005-CONV-DT10INDT8
      *          THRU AQCP0005-CONV-DT10INDT8-EXIT
      *       MOVE AQCW0005-DT98           TO WS-DATAVL-MIN
      *    ELSE
      *       MOVE CON-DATA-MAX            TO WS-DATAVL-MIN
      *    END-IF.

           IF SWCV5150-DDATA NOT EQUAL VIAK0002-DATA-MINIMA
              MOVE SWCV5150-DDATA          TO AQCW0005-DTX10
              PERFORM AQCP0005-CONV-DT10INDT8
                 THRU AQCP0005-CONV-DT10INDT8-EXIT
              MOVE AQCW0005-DT98           TO WS-DATAVL-MAX
           ELSE
              MOVE CON-DATA-MAX            TO WS-DATAVL-MAX
           END-IF.

           MOVE SWCV5150-CSEND             TO WS-CSEND.
           MOVE SWCV5150-CCONTA            TO WS-CCONTA.
           MOVE WS-C2COD-CBAN              TO SWCD5808-CBAN.
           MOVE WS-C2COD-CSPAI             TO SWCD5808-CSPAI.
           MOVE SWCV5150-CMOED             TO SWCD5808-CMOED.

      * Paginacao
           MOVE SWCV5150-DATVAL-PAG        TO AQCW0005-DTX10.
           PERFORM AQCP0005-CONV-DT10INDT8
              THRU AQCP0005-CONV-DT10INDT8-EXIT.
           MOVE AQCW0005-DT98              TO SWCD5808-DATVAL.
           MOVE SWCV5150-COSN-PAG          TO SWCD5808-COSN.
           MOVE SWCV5150-COSNC-PAG         TO SWCD5808-COSNC.

           SET SW-CURSOR-NONE              TO TRUE.

           IF SW-CURSOR-NONE
              SET SW-CURSOR-1              TO TRUE
           END-IF.

           EVALUATE TRUE
              WHEN SW-CURSOR-1
                 EXEC SQL
                    OPEN CURSWT58
                 END-EXEC
           END-EVALUATE.

           MOVE CON-SWVT5808               TO VIAL0002-TABLE-NAME.

           PERFORM 9020-DB2CHECK
              THRU 9029-DB2CHECK-EXIT.

       2029-OPEN-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *                     2030-FETCH
      *-----------------------------------------------------------------
       2030-FETCH.
           IF VIAL0001-DEBUG-SIM
              MOVE '2030-FETCH'            TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           EVALUATE TRUE
              WHEN SW-CURSOR-1
                 EXEC SQL
                    FETCH CURSWT58
                     INTO :SWCD5808-DATVAL
                        , :SWCD5808-COSN
                        , :SWCD5808-COSNC
                        , :SWCD5808-CREF
                        , :SWCD5808-CREFOPR
                        , :SWCD5808-CREFEXT
                        , :SWCD5808-CTIPOP
                        , :SWCD5808-MVALOR
                        , :SWCD5808-CDBCR
                        , :SWCD5808-CEXT
                        , :SWCD5808-CPAG
                 END-EXEC
           END-EVALUATE.

           MOVE CON-SWVT5808               TO VIAL0002-TABLE-NAME.

           PERFORM 9020-DB2CHECK
              THRU 9029-DB2CHECK-EXIT.

       2039-FETCH-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *                       2040-CONTINUA
      *-----------------------------------------------------------------
       2040-CONTINUA.
           IF VIAL0001-DEBUG-SIM
              MOVE '2040-CONTINUA'         TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           MOVE ZEROES                     TO SWCV5151-INDICE.
           PERFORM 2050-TRATA-OCCURS
              THRU 2059-TRATA-OCCURS-EXIT
             UNTIL NOT DB2-OK
                OR SWCV5151-PAGINA-CHEIA
                OR NOT VIAL0002-SEM-ERROS.

           IF VIAL0002-SEM-ERROS
              IF NOT SWCV5151-PAGINA-CHEIA
                 COMPUTE SWCV5151-INDICE-INVERSO EQUAL
                         SWCV5151-INDICE-INVERSO - SWCV5151-INDICE
                 COMPUTE SWCV5151-DIMINUI-LENGTH EQUAL
                         SWCV5151-INDICE-INVERSO * SWCV5151-LENGTH-OCCUR
                 COMPUTE SWCV5151-LENGTH EQUAL SWCV5151-LENGTH -
                         SWCV5151-DIMINUI-LENGTH
                 SET VIAL0002-FIM-CONSULTA TO TRUE
              END-IF

              IF DB2-NOTFND
                 SET VIAL0002-FIM-CONSULTA TO TRUE
              END-IF
           END-IF.

       2049-CONTINUA-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *            2050-TRATA-OCCURS
      *-----------------------------------------------------------------
       2050-TRATA-OCCURS.
           IF VIAL0001-DEBUG-SIM
              MOVE '2050-TRATA-OCCURS' TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           ADD 1                           TO SWCV5151-INDICE.

      * CONVERTE DATA DE 9(08) PARA X(10)
           MOVE SWCD5808-DATVAL            TO AQCW0005-DT98
           PERFORM AQCP0005-CONV-DT8INDT10
              THRU AQCP0005-CONV-DT8INDT10-EXIT
           MOVE AQCW0005-DTX10 TO SWCV5151-D-DATVAL(SWCV5151-INDICE)
                                  SWCV5151-DATVAL-PAG.

           MOVE SWCD5808-COSN
                               TO SWCV5151-D-COSN(SWCV5151-INDICE)
                                  SWCV5151-COSN-PAG.
           MOVE SWCD5808-COSNC
                               TO SWCV5151-D-COSNC(SWCV5151-INDICE)
                                  SWCV5151-COSNC-PAG.
           MOVE SWCD5808-CREF
                               TO SWCV5151-D-CREF(SWCV5151-INDICE).
           MOVE SWCD5808-CREFOPR
                               TO SWCV5151-D-CREFOPR(SWCV5151-INDICE).
           MOVE SWCD5808-CREFEXT
                               TO SWCV5151-D-CREFEXT(SWCV5151-INDICE).
           MOVE SWCD5808-CTIPOP
                               TO SWCV5151-D-CTIPOP(SWCV5151-INDICE).
           MOVE SWCD5808-MVALOR
                               TO SWCV5151-D-MVALOR(SWCV5151-INDICE).
           MOVE SWCD5808-CDBCR
                               TO SWCV5151-D-CDBCR(SWCV5151-INDICE).
           MOVE SWCD5808-CEXT
                               TO SWCV5151-D-CEXT(SWCV5151-INDICE).
           MOVE SWCD5808-CPAG
                               TO SWCV5151-D-CPAG(SWCV5151-INDICE).

           PERFORM 2030-FETCH
              THRU 2039-FETCH-EXIT.

       2059-TRATA-OCCURS-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *                     2070-CLOSE
      *-----------------------------------------------------------------
       2070-CLOSE.
           IF VIAL0001-DEBUG-SIM
              MOVE '2070-CLOSE'            TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           EVALUATE TRUE
              WHEN SW-CURSOR-1
                 EXEC SQL
                    CLOSE CURSWT01
                 END-EXEC
           END-EVALUATE.

       2079-CLOSE-EXIT.
           EXIT.

      *-----------------------------------------------------------------
      *            3000-FINAL-PROGRAMA
      *-----------------------------------------------------------------
       3000-FINAL-PROGRAMA.
           IF VIAL0001-DEBUG-SIM
              MOVE '3000-FINAL-PROGRAMA'   TO VIAL0015-CALLER-ID
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.

           IF SWCV5150-NMAXLIST EQUAL ZEROES
              MOVE VIAL0001-CAPLIC         TO ARCL0039-CAPLIC
              MOVE VIAL0001-COPCAO         TO ARCL0039-COPCAO
              PERFORM ARCR0039-NMAXLIST
                 THRU ARCR0039-NMAXLIST-EXIT

              IF ETCL0002-ABEND-DB2
                 MOVE ETCL0002-TABLE-NAME  TO VIAL0002-TABLE-NAME
                 MOVE ETCL0002-SQLCA       TO VIAL0002-SQLCA
              END-IF

              MOVE ARCL0039-NMAXLIST       TO SWCV5151-NMAXLIST
           ELSE
              MOVE SWCV5150-NMAXLIST       TO SWCV5151-NMAXLIST
           END-IF.

           MOVE SWCV5151-MSG               TO VIAL0001-MENSAGEM-OUTPUT.
           MOVE SWCV5151-LENGTH            TO VIAL0001-LENGTH-MSG.
           MOVE SWCV5151-NR-CAMPOS         TO VIAL0001-NR-CAMPOS.
           MOVE SWCV5151-INDICE            TO VIAL0001-OCORRENCIAS.

       3099-FINAL-PROGRAMA-EXIT.
           EXIT.

      *-----------------------------------------------------------------
           EXEC SQL INCLUDE VIAP0003 END-EXEC.
      *==============================================================
           COPY VIAP0016.
           COPY AQCP0005.
           COPY ARCR0039.
