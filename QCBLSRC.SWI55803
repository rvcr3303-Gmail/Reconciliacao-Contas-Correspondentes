      ******************************************************************
       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       DATA DIVISION.
      *--------------------------------------------------------------
       WORKING-STORAGE SECTION.
      *--------------------------------------------------------------
       01  FILLER                          PIC X(40) VALUE
           'INICIO WORKING-STORAGE SWI55803         '.
      *--------------------------------------------------------------
      *            DECLARACOES DE DB2
      *--------------------------------------------------------------
           EXEC SQL INCLUDE SQLCA    END-EXEC.
      *--------------------------------------------------------------
      *            MENSAGEM DE INPUT E  OUTPUT
      *--------------------------------------------------------------
       COPY SWCV5580.
       COPY SWCV5581.
      *--------------------------------------------------------------
      *            AREAS DE TRABALHO
      *--------------------------------------------------------------
       COPY VIAL0015.
       COPY VIAW0005.
       COPY VIAK0001.
       COPY VIAK0002.
       COPY TGCL1000.
       COPY TGCL2000.
       COPY TGCK0002.
      *
      *
      *--------------------------------------------------------------
      *            CONSTANTES
      *--------------------------------------------------------------
       01  WS-CONSTANTES.
           05 WS-PROGNAME                  PIC X(08) VALUE 'SWI55803'.
           05 CON-CTABELA-CSEND            PIC X(05) VALUE 'BM004'.
           05 CON-CTABELA-CCONTA           PIC X(05) VALUE 'BM025'.
           05 CON-CTABELA-CMOED            PIC X(05) VALUE 'BM028'.
PML   *    05 CON-CTABELA-IRECONC          PIC X(05) VALUE 'SW005'.
PML        05 CON-CTABELA-CCODEST          PIC X(05) VALUE 'SW082'.
           05 CON-CTABELA-CINTERV          PIC X(05) VALUE 'SW078'.
           05 CON-CTABELA-GUSERNAME        PIC X(05) VALUE 'SW079'.
AG         05 CON-CTABELA-ITIPORECONC      PIC X(05) VALUE 'SW081'.
      *--------------------------------------------------------------
      *            VARIAVEIS
      *--------------------------------------------------------------
       01  WS-VARIAVEIS.
           05 WS-CTABELA                   PIC X(05) VALUE SPACES.
           05 WS-CCOD                      PIC X(40) VALUE SPACES.
           05 WS-C2COD                     PIC X(40) VALUE SPACES.
           05 WS-CINTERV                   PIC X(12) VALUE SPACES.
      *--------------------------------------------------------------
       01  FILLER                        PIC X(40) VALUE
           'FIM DA WORKING-STORAGE SWI55803         '.
      *--------------------------------------------------------------
       LINKAGE SECTION.
      *--------------------------------------------------------------
      *
       COPY VIAL0004.
      *
            EXEC SQL INCLUDE VIAP0009 END-EXEC.
      *
      *--------------------------------------------------------------
      *            0000-MAINLINE
      *--------------------------------------------------------------
       0000-MAINLINE.
      *
           PERFORM 1000-INICIO-PROGRAMA
              THRU 1099-INICIO-PROGRAMA-EXIT.

           PERFORM 2000-PROC-PROGRAMA
              THRU 2099-PROC-PROGRAMA-EXIT.

           PERFORM 3000-FINAL-PROGRAMA
              THRU 3099-FINAL-PROGRAMA-EXIT.
      *
       0099-MAINLINE-EXIT.
           COPY VIAP0004.
      *--------------------------------------------------------------
      *            1000-INICIO-PROGRAMA
      *--------------------------------------------------------------
       1000-INICIO-PROGRAMA.
      *
           MOVE '1000-INICIO-PROGRAMA' TO VIAL0015-CALLER-ID
      *    IF VIAL0001-DEBUG-SIM
      *       PERFORM VIAP0016-TRATA-DEBUG
      *          THRU VIAP0016-TRATA-DEBUG-EXIT
      *    END-IF.
      *
           MOVE VIAL0001-MENSAGEM-INPUT    TO SWCV5580-MSG.
           MOVE VIAL0001-MENSAGEM-OUTPUT   TO SWCV5581-MSG.
      *
DEBUG      IF VIAL0001-DEBUG-SIM
DEBUG         MOVE '1000-INICIO-PROGRAMA'    TO VIAL0015-CALLER-ID
DEBUG         MOVE 'SWCV5580-ITIPORECON '    TO VIAL0015-CAMPO-NM (1)
DEBUG         MOVE  SWCV5580-ITIPORECON      TO VIAL0015-CAMPO-VLR(1)
DEBUG         PERFORM VIAP0016-TRATA-DEBUG
DEBUG            THRU VIAP0016-TRATA-DEBUG-EXIT
DEBUG      END-IF.
      *
       1099-INICIO-PROGRAMA-EXIT.
           EXIT.
      *--------------------------------------------------------------
      *            2000-PROC-PROGRAMA
      *--------------------------------------------------------------
       2000-PROC-PROGRAMA.
      *
           MOVE '2000-PROC-PROGRAMA' TO VIAL0015-CALLER-ID
      *    IF VIAL0001-DEBUG-SIM
      *       PERFORM VIAP0016-TRATA-DEBUG
      *          THRU VIAP0016-TRATA-DEBUG-EXIT
      *    END-IF.

           IF VIAL0002-SEM-ERROS
              PERFORM 2100-VAL-CAMPOS
                 THRU 2100-VAL-CAMPOS-EXIT
           END-IF.

       2099-PROC-PROGRAMA-EXIT.
           EXIT.
      *--------------------------------------------------------------
      *                   2100-VAL-CAMPOS
      *--------------------------------------------------------------
       2100-VAL-CAMPOS.
      *
           MOVE '2100-VAL-CAMPOS' TO VIAL0015-CALLER-ID
           IF VIAL0001-DEBUG-SIM
              PERFORM VIAP0016-TRATA-DEBUG
                 THRU VIAP0016-TRATA-DEBUG-EXIT
           END-IF.


           IF VIAL0002-SEM-ERROS AND SWCV5580-CSEND NOT EQUAL SPACES
              MOVE CON-CTABELA-CSEND
                TO WS-CTABELA
              MOVE SWCV5580-CSEND
                TO WS-CCOD
              MOVE SPACES
                TO WS-C2COD
              PERFORM 2300-VAL-TAB-OUTRA
                 THRU 2300-VAL-TAB-OUTRA-EXIT
              IF NOT VIAL0002-SEM-ERROS
                 MOVE TGCL1000-CCOD-S      TO SWCV5581-CSEND-S
                 MOVE TGCL1000-CCOD-CAPLIC TO SWCV5581-CSEND-CAPLIC
                 MOVE TGCL1000-CCOD-MSG    TO SWCV5581-CSEND-MSG
                 MOVE TGCL1000-GDESC       TO SWCV5581-XDESCCSEND
              ELSE
                 MOVE TGCL1000-GDESC       TO SWCV5580-XDESCCSEND
              END-IF
           END-IF.
      *
           IF VIAL0002-SEM-ERROS AND SWCV5580-CCONTA NOT EQUAL SPACES
              MOVE CON-CTABELA-CCONTA
                TO WS-CTABELA
              MOVE SWCV5580-CCONTA
                TO WS-CCOD
              MOVE SWCV5580-CSEND
                TO WS-C2COD
              PERFORM 2300-VAL-TAB-OUTRA
                 THRU 2300-VAL-TAB-OUTRA-EXIT
              IF NOT VIAL0002-SEM-ERROS
                 MOVE TGCL1000-CCOD-S      TO SWCV5581-CCONTA-S
                 MOVE TGCL1000-CCOD-CAPLIC TO SWCV5581-CCONTA-CAPLIC
                 MOVE TGCL1000-CCOD-MSG    TO SWCV5581-CCONTA-MSG
                 MOVE TGCL1000-GDESC       TO SWCV5581-XDESCCCONTA
              ELSE
                 MOVE TGCL1000-GDESC       TO SWCV5580-XDESCCCONTA
              END-IF
           END-IF.
      *
           IF VIAL0002-SEM-ERROS AND SWCV5580-CMOED NOT EQUAL SPACES
              MOVE CON-CTABELA-CMOED
                TO WS-CTABELA
              MOVE SWCV5580-CMOED
                TO WS-CCOD
              MOVE SWCV5580-CCONTA
                TO WS-C2COD
              PERFORM 2300-VAL-TAB-OUTRA
                 THRU 2300-VAL-TAB-OUTRA-EXIT
              IF NOT VIAL0002-SEM-ERROS
                 MOVE TGCL1000-CCOD-S      TO SWCV5581-CMOED-S
                 MOVE TGCL1000-CCOD-CAPLIC TO SWCV5581-CMOED-CAPLIC
                 MOVE TGCL1000-CCOD-MSG    TO SWCV5581-CMOED-MSG
                 MOVE TGCL1000-GDESC       TO SWCV5581-XDESCCMOED
              ELSE
                 MOVE TGCL1000-GDESC       TO SWCV5580-XDESCCMOED
              END-IF
           END-IF.
      *
           IF VIAL0002-SEM-ERROS AND SWCV5580-CCODESTX NOT EQUAL SPACES
              MOVE CON-CTABELA-CCODEST
                TO WS-CTABELA
              MOVE SWCV5580-CCODESTX
                TO WS-CCOD
              MOVE SPACES
                TO WS-C2COD
              PERFORM 2200-VAL-TAB-ART05
                 THRU 2200-VAL-TAB-ART05-EXIT
              IF NOT VIAL0002-SEM-ERROS
                 MOVE TGCL2000-CCOD-S      TO SWCV5581-CCODESTX-S
                 MOVE TGCL2000-CCOD-CAPLIC TO SWCV5581-CCODESTX-CAPLIC
                 MOVE TGCL2000-CCOD-MSG    TO SWCV5581-CCODESTX-MSG
                 MOVE TGCL2000-GDESC       TO SWCV5581-XDESCCCODESTX
              ELSE
                 MOVE TGCL2000-GDESC       TO SWCV5580-XDESCCCODESTX
              END-IF
           END-IF.
      *
AG         IF VIAL0002-SEM-ERROS AND SWCV5580-CINTERV NOT EQUAL SPACES
|
|             MOVE CON-CTABELA-CINTERV
|               TO WS-CTABELA
|             MOVE SWCV5580-CINTERV
|               TO WS-CCOD
|             MOVE SWCV5580-CPERFIL
|               TO WS-C2COD
|             PERFORM 2200-VAL-TAB-ART05
|                THRU 2200-VAL-TAB-ART05-EXIT
|             IF NOT VIAL0002-SEM-ERROS
|                MOVE TGCL2000-CCOD-S      TO SWCV5581-CINTERV-S
|                MOVE TGCL2000-CCOD-CAPLIC TO SWCV5581-CINTERV-CAPLIC
|                MOVE TGCL2000-CCOD-MSG    TO SWCV5581-CINTERV-MSG
|                MOVE TGCL2000-GDESC       TO SWCV5581-XDESCCINTERV
|             ELSE
|                MOVE TGCL2000-GDESC       TO SWCV5580-XDESCCINTERV
|             END-IF
|          END-IF.
|
|          IF VIAL0002-SEM-ERROS AND SWCV5580-GUSERNAME NOT EQUAL SPACES
|             MOVE CON-CTABELA-GUSERNAME
|               TO WS-CTABELA
|             MOVE SWCV5580-GUSERNAME
|               TO WS-CCOD
|             MOVE SWCV5580-CPERFIL
|               TO WS-C2COD
|             PERFORM 2300-VAL-TAB-OUTRA
|                THRU 2300-VAL-TAB-OUTRA-EXIT
|             IF NOT VIAL0002-SEM-ERROS
|                MOVE TGCL1000-CCOD-S      TO SWCV5581-GUSERNAME-S
|                MOVE TGCL1000-CCOD-CAPLIC TO SWCV5581-GUSERNAME-CAPLIC
|                MOVE TGCL1000-CCOD-MSG    TO SWCV5581-GUSERNAME-MSG
|                MOVE TGCL1000-GDESC       TO SWCV5581-XDESCGUSERNAME
|             ELSE
|                MOVE TGCL1000-GDESC       TO SWCV5580-XDESCGUSERNAME
|             END-IF
AG         END-IF.

AG         IF VIAL0002-SEM-ERROS
|             AND SWCV5580-ITIPORECON NOT EQUAL SPACES
|             MOVE CON-CTABELA-ITIPORECONC
|               TO WS-CTABELA
|     *       MOVE FUNCTION UPPER-CASE(SWCV5580-ITIPORECON)
PML           MOVE SWCV5580-ITIPORECON
|               TO WS-CCOD
|             MOVE SPACES
|               TO WS-C2COD
|             PERFORM 2200-VAL-TAB-ART05
|                THRU 2200-VAL-TAB-ART05-EXIT
|             IF NOT VIAL0002-SEM-ERROS
|                MOVE TGCL2000-CCOD-S      TO SWCV5581-ITIPORECON-S
|                MOVE TGCL2000-CCOD-CAPLIC TO
|                                          SWCV5581-ITIPORECON-CAPLIC
|                MOVE TGCL2000-CCOD-MSG    TO SWCV5581-ITIPORECON-MSG
|                MOVE TGCL2000-GDESC       TO SWCV5581-XDESCITIPORECON
|             ELSE
|                MOVE TGCL2000-GDESC       TO SWCV5580-XDESCITIPORECON
|             END-IF
AG         END-IF.
      *
       2100-VAL-CAMPOS-EXIT.
           EXIT.

      *--------------------------------------------------------------
      *                   2200-VAL-TAB-ART05
      *--------------------------------------------------------------
       2200-VAL-TAB-ART05.
      *
           MOVE '2200-VAL-TAB-ART05' TO VIAL0015-CALLER-ID

      *
           INITIALIZE TGCL2000-MSG       REPLACING  NUMERIC BY ZEROES
                                               ALPHANUMERIC BY SPACES.

           MOVE WS-CTABELA                TO TGCL2000-CTABELA
           MOVE WS-CCOD                   TO TGCL2000-CCOD
           MOVE WS-C2COD                  TO TGCL2000-C2COD

DEBUG      IF VIAL0001-DEBUG-SIM
DEBUG         MOVE '2200-VAL-TAB-ART05-ENTER' TO VIAL0015-CALLER-ID
DEBUG         MOVE 'TGCL2000-CTABELA    '    TO VIAL0015-CAMPO-NM(1)
DEBUG         MOVE  TGCL2000-CTABELA         TO VIAL0015-CAMPO-VLR(1)
DEBUG         MOVE 'TGCL2000-CCOD       '    TO VIAL0015-CAMPO-NM(2)
DEBUG         MOVE  TGCL2000-CCOD            TO VIAL0015-CAMPO-VLR(2)
DEBUG         MOVE 'TGCL2000-C2COD      '    TO VIAL0015-CAMPO-NM(3)
DEBUG         MOVE  TGCL2000-C2COD           TO VIAL0015-CAMPO-VLR(3)
DEBUG         MOVE 'TGCL2000-GDESC      '    TO VIAL0015-CAMPO-NM(4)
DEBUG         MOVE  TGCL2000-GDESC           TO VIAL0015-CAMPO-VLR(4)
DEBUG         MOVE 'VIAL0002-IND-ERROS  '    TO VIAL0015-CAMPO-NM(5)
DEBUG         MOVE  VIAL0002-IND-ERROS       TO VIAL0015-CAMPO-VLR(5)
DEBUG         PERFORM VIAP0016-TRATA-DEBUG
DEBUG            THRU VIAP0016-TRATA-DEBUG-EXIT
DEBUG      END-IF.

           PERFORM CALL-TGCP2000
              THRU CALL-TGCP2000-EXIT.

DEBUG      IF VIAL0001-DEBUG-SIM
DEBUG         MOVE '2200-VAL-TAB-ART05-EXIT' TO VIAL0015-CALLER-ID
DEBUG         MOVE 'TGCL2000-CTABELA    '    TO VIAL0015-CAMPO-NM(1)
DEBUG         MOVE  TGCL2000-CTABELA         TO VIAL0015-CAMPO-VLR(1)
DEBUG         MOVE 'TGCL2000-CCOD       '    TO VIAL0015-CAMPO-NM(2)
DEBUG         MOVE  TGCL2000-CCOD            TO VIAL0015-CAMPO-VLR(2)
DEBUG         MOVE 'TGCL2000-C2COD      '    TO VIAL0015-CAMPO-NM(3)
DEBUG         MOVE  TGCL2000-C2COD           TO VIAL0015-CAMPO-VLR(3)
DEBUG         MOVE 'TGCL2000-GDESC      '    TO VIAL0015-CAMPO-NM(4)
DEBUG         MOVE  TGCL2000-GDESC           TO VIAL0015-CAMPO-VLR(4)
DEBUG         MOVE 'VIAL0002-IND-ERROS  '    TO VIAL0015-CAMPO-NM(5)
DEBUG         MOVE  VIAL0002-IND-ERROS       TO VIAL0015-CAMPO-VLR(5)
DEBUG         PERFORM VIAP0016-TRATA-DEBUG
DEBUG            THRU VIAP0016-TRATA-DEBUG-EXIT
DEBUG      END-IF.

       2200-VAL-TAB-ART05-EXIT.
           EXIT.

      *--------------------------------------------------------------
      *                   2300-VAL-TAB-OUTRA
      *--------------------------------------------------------------
       2300-VAL-TAB-OUTRA.
      *
           MOVE '2300-VAL-TAB-OUTRA' TO VIAL0015-CALLER-ID

           INITIALIZE TGCL1000-MSG       REPLACING  NUMERIC BY ZEROES
                                               ALPHANUMERIC BY SPACES.

           MOVE WS-CTABELA                TO TGCL1000-CTABELA
           MOVE WS-CCOD                   TO TGCL1000-CCOD
           MOVE WS-C2COD                  TO TGCL1000-C2COD
		
           PERFORM CALL-TGCP1000
              THRU CALL-TGCP1000-EXIT.

DEBUG      IF VIAL0001-DEBUG-SIM
DEBUG         MOVE 'TGCL1000-CTABELA    '    TO VIAL0015-CAMPO-NM(1)
DEBUG         MOVE  TGCL1000-CTABELA         TO VIAL0015-CAMPO-VLR(1)
DEBUG         MOVE 'TGCL1000-CCOD       '    TO VIAL0015-CAMPO-NM(2)
DEBUG         MOVE  TGCL1000-CCOD            TO VIAL0015-CAMPO-VLR(2)
DEBUG         MOVE 'TGCL1000-C2COD      '    TO VIAL0015-CAMPO-NM(3)
DEBUG         MOVE  TGCL1000-C2COD           TO VIAL0015-CAMPO-VLR(3)
DEBUG         MOVE 'TGCL1000-GDESC      '    TO VIAL0015-CAMPO-NM(4)
DEBUG         MOVE  TGCL1000-GDESC           TO VIAL0015-CAMPO-VLR(4)
DEBUG         MOVE 'VIAL0002-IND-ERROS  '    TO VIAL0015-CAMPO-NM(5)
DEBUG         MOVE  VIAL0002-IND-ERROS       TO VIAL0015-CAMPO-VLR(5)
DEBUG         PERFORM VIAP0016-TRATA-DEBUG
DEBUG            THRU VIAP0016-TRATA-DEBUG-EXIT
DEBUG      END-IF.

       2300-VAL-TAB-OUTRA-EXIT.
           EXIT.

      *--------------------------------------------------------------
      *            3000-FINAL-PROGRAMA
      *--------------------------------------------------------------
       3000-FINAL-PROGRAMA.
      *
           MOVE '3000-FINAL-PROGRAMA' TO VIAL0015-CALLER-ID
      *    IF VIAL0001-DEBUG-SIM
      *       PERFORM VIAP0016-TRATA-DEBUG
      *          THRU VIAP0016-TRATA-DEBUG-EXIT
      *    END-IF.

           MOVE SWCV5581-MSG               TO VIAL0001-MENSAGEM-OUTPUT.
           MOVE SWCV5580-MSG               TO VIAL0001-MENSAGEM-INPUT.

       3099-FINAL-PROGRAMA-EXIT.
           EXIT.
      *--------------------------------------------------------------
           EXEC SQL INCLUDE VIAP0003 END-EXEC.
      *==============================================================
           COPY VIAP0016.
           COPY TGCP1000.
           COPY TGCP2000.

