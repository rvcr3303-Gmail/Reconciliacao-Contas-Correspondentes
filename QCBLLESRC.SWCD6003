             , COSNC CHAR(10) NOT NULL
             , CEXT CHAR(05) NOT NULL
             , CPAG  CHAR(05) NOT NULL
           ) END-EXEC.
      ******************************************************************
      * COBOL DECLARATION FOR TABLE SWVT6003
      ******************************************************************
       01  DCLSWCD6003.
            05 SWCD6003-FXCODMSG PIC X(06).
            05 SWCD6003-FXDATVAL PIC S9(08) COMP-3.
            05 SWCD6003-FXREFOPR PIC X(16).
