/***********************************************************************/
/* Reconstrução dos totais da tabela SWT63 c/periodo                   */
/***********************************************************************/
/*           L O G     D E     A L T E R A C O E S                     */
/***********************************************************************/
/*  INICIO  * AUTOR  * FIM    *  C O M E N T A R I O S                 */
/*          *        *        *                                        */
/*          *        *        *                                        */
/***********************************************************************/
      PGM PARM(&$RCODE)
/***********************************************************************/
      DCL VAR(&$RCODE)  TYPE(*DEC)  LEN(1 0)
      DCL VAR(&RCODE)   TYPE(*DEC)  LEN(2 0)  VALUE(0)
/***********************************************************************/
      CALL   PGM(SWB4850) PARM(&RCODE)
      CHGVAR VAR(&$RCODE) VALUE(&RCODE)
/***                                                                 ***/
      ENDPGM
